{
  "name": "vectorvault",
  "version": "2.2.5",
  "description": "Vector database for AI applications - pure TypeScript vector search with no native dependencies",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:watch": "vitest --pool=forks --poolOptions.forks.singleFork=true",
    "test:local": "vitest run tests/local.test.ts --pool=forks --poolOptions.forks.singleFork=true",
    "test:cloud": "vitest run tests/cloud.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-Rood/vectorvault-js.git"
  },
  "keywords": [
    "vectorvault",
    "vector",
    "database",
    "embeddings",
    "RAG",
    "AI",
    "local",
    "typescript"
  ],
  "author": "John Rood",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/John-Rood/vectorvault-js/issues"
  },
  "homepage": "https://github.com/John-Rood/vectorvault-js#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
